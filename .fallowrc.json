{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/bump-version.mjs",
    "scripts/release-on-main.mjs",
    "scripts/setup-git-hooks.mjs",
    "scripts/prepare-e2e-dev.mjs",
    "scripts/append-release-coverage.mjs",
    "scripts/coverage-release-summary.mjs"
  ],
  "workspaces": {
    "packages": ["."]
  },
  "duplicates": {
    "minOccurrences": 3
  },
  "audit": {
    "gate": "new-only"
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
