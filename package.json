{
  "name": "retetefit",
  "version": "1.0.0",
  "private": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "recipe:prepare-images": "node ./.agents/skills/recipe-publisher/scripts/prepare-recipe-images.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "prerelease": "pnpm format && pnpm lint:fix && pnpm test:coverage && pnpm test:e2e && pnpm build && pnpm fallow:audit",
    "release:on-main": "node scripts/release-on-main.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/prepare-e2e-dev.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "fallow": "fallow",
    "fallow:audit": "fallow audit"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.552.0",
    "next": "16.0.10",
    "next-intl": "^4.4.0",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.1",
    "remark-breaks": "^4.0.0",
    "server-only": "^0.0.1",
    "shiki": "^3.14.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fallow": "2.89.0",
    "happy-dom": "20.10.2",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "4.1.8"
  }
}
